# Copiar a .env y ajustar. NINGUNO de estos valores es secreto hoy: la conexion
# a SQL Server va por autenticacion integrada de Windows (Trusted_Connection).
#
# Si algun dia hiciera falta usuario y contrasena, van en DGL_SQL_USER y
# DGL_SQL_PASSWORD -- y .env esta en .gitignore precisamente por eso.

# --- Aplicacion web -------------------------------------------------------
# development o production. OJO: en development NO se aplican el redirect a
# HTTPS, HSTS ni la verificacion de origen. Para trabajar en local quieres
# development; el .env de la maquina de desarrollo dice production, que es lo
# que confunde a quien clona.
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

# 2 y no 4: los workers NO comparten memoria, cada uno carga su copia de los
# parquets. Medido: 427 MB con 4, 226 MB con 2.
WORKERS=2
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=7
RATE_LIMIT=60/hour
PRODUCTION_ORIGIN=https://sabertables.com

# --- Rango de temporadas de la extraccion --------------------------------
# Las tres acotan TODA la extraccion. Explicacion en utils/seasons.py.
MIN_SEASON=1910
MIN_PER_PITCH_SEASON=1989
MAX_SEASON=2025

# --- Base de datos (solo para el pipeline de utils/) ----------------------
# La web NO toca la base: lee parquets. Esto solo hace falta para regenerarlos.
# DGL_SQL_SERVERS acepta varios separados por coma y los prueba en orden.
DGL_SQL_SERVERS=localhost
DGL_SQL_DATABASE=DGL
DGL_SQL_DRIVER=ODBC Driver 18 for SQL Server
DGL_SQL_TRUST_CERT=yes
# Segundos de espera al conectar antes de pasar al siguiente servidor.
DGL_SQL_TIMEOUT=5
# DGL_SQL_USER=
# DGL_SQL_PASSWORD=
